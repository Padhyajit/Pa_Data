from pyspark.sql.functions import col, when, expr

# 1. Load the Silver Table
df_silver = spark.table("Cleaned_Telco_Churn")

# 2. Strategy: Create a 'ServiceCount' feature 
# This tells us how 'sticky' a customer is based on how many add-ons they have.
service_cols = ['OnlineSecurity', 'OnlineBackup', 'DeviceProtection', 'TechSupport', 'StreamingTV', 'StreamingMovies']

df_gold = df_silver.withColumn("ServiceCount", 
    sum([when(col(c) == "Yes", 1).otherwise(0) for c in service_cols]))

# 3. Strategy: Create a 'HighRisk_HighCharges' flag
